<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The app carries no Firebase or Google Play services. Reown pulls firebase-messaging in
         transitively, so the manifest drops every component and permission that comes with it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" tools:node="remove" />

    <!-- Lets the wallet picker see installed wallets (Android 11 package visibility). -->
    <queries>
        <package android:name="io.metamask" />
        <package android:name="com.wallet.crypto.trustapp" />
        <package android:name="me.rainbow" />
        <package android:name="io.zerion.android" />
        <package android:name="io.gnosis.safe" />
    </queries>

    <application
        android:name=".LatiFiApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LatiFi"
        android:usesCleartextTraffic="false">
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <service
            android:name="com.google.firebase.components.ComponentDiscoveryService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <activity
            android:name="com.google.android.gms.common.api.GoogleApiActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <meta-data
            android:name="com.google.android.gms.version"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LatiFi.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="request"
                    android:scheme="latifi-wallet" />
            </intent-filter>
        </activity>

        <!-- Stores the per-app language on API 26 to 32. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
